{
  "name": "wordreference-translate-extension",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "build:autocomplete-datasets": "python scripts/build_autocomplete_datasets.py",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "keywords": [
    "browser-extension",
    "edge-extension",
    "wxt",
    "wordreference"
  ],
  "license": "MIT",
  "description": "WordReference Translate browser extension built with WXT, TypeScript, and React.",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.46.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wxt": "^0.20.25"
  }
}
